# Umalakshmi Educational Trust — site settings.
# Copy to .env (never commit .env). On cPanel put the .env one level ABOVE public_html,
# e.g. /home/<cpanel-user>/.env; the site also accepts /public_html/.env (blocked by .htaccess).

APP_ENV=production            # production | local
APP_DEBUG=0                   # 1 shows PHP errors on screen (local only)
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://www.umalakshmitrust.com
APP_ACADEMIC_YEAR=            # e.g. 2026-27; blank = worked out from today's date

# cPanel → MySQL® Databases (names are prefixed with the cPanel user, e.g. umalaksh_site)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
# DB_SOCKET=/tmp/mysql.sock    # local development only

# Private folder for uploaded documents — OUTSIDE public_html on cPanel,
# e.g. /home/<cpanel-user>/uet_uploads  (created automatically, must be writable by PHP)
UPLOAD_DIR=

# Outgoing mail. Create a mailbox in cPanel → Email Accounts, e.g. noreply@umalakshmitrust.com
MAIL_DRIVER=smtp              # smtp | log   (log writes .eml files under UPLOAD_DIR/mail-log instead of sending)
MAIL_HOST=mail.umalakshmitrust.com
MAIL_PORT=465                 # 465 with ssl, or 587 with tls
MAIL_ENCRYPTION=ssl           # ssl | tls | none
MAIL_USER=noreply@umalakshmitrust.com
MAIL_PASS=
MAIL_FROM=noreply@umalakshmitrust.com
MAIL_FROM_NAME=Umalakshmi Educational Trust
# Where the trust's copy of every application / message goes (comma-separate several)
TRUST_INBOX=umalakshmieducationaltrust@gmail.com
# Replies from applicants go here
MAIL_REPLY_TO=umalakshmieducationaltrust@gmail.com

# Upload limits (per file, MB). Keep below upload_max_filesize in .user.ini
MAX_PHOTO_MB=2
MAX_DOC_MB=5
